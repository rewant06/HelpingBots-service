    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.10",
    "passport-jwt": "^4.0.1",
    "piscina": "^5.1.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "service": "^0.1.4",
    "ua-parser-js": "^2.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
